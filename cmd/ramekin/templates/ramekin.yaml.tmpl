name: [[.Name]]
# Platform of the target devices. %post in the final stage runs under qemu
# binfmt when it differs from the workstation; earlier stages run natively.
platform: [[.Platform]]

source:
  # def:     build an Apptainer definition file (infrastructure as code)
  # overlay: `ramekin shell` into the base image; changes persist in overlay.img
  mode: [[.Mode]]
  # Def mode only: your definition file. Name it whatever you like.
  def: example.def
  # Overlay mode only: the base image to start from.
  base: [[.Base]]
  overlay: overlay.img
  overlay_size_mb: 1024
  # Overlay mode only: the command the container runs.
  # runscript: /usr/bin/my-app

scan:
  # Severity at which `ramekin publish` refuses to ship: negligible|low|medium|high|critical|none
  fail_on: high
  # Accepted risks, e.g. CVE-2024-12345
  ignore: []

alerts:
  # Webhook that receives CVE alerts (Slack, Discord, Mattermost, ntfy, ...).
  webhook: ""
  min_severity: high

signing:
  key: keys/ramekin-sign.key
  pubkey: keys/ramekin-sign.pub

encryption:
  # age recipients that can decrypt releases. `ramekin keys generate` adds
  # the fleet key; `ramekin device init --own-key` adds per-device keys.
  recipients_file: keys/recipients.txt

store:
  # Sliplane Object Storage: create the bucket with versioning AND object
  # locking enabled, then copy its endpoint URL from the Sliplane dashboard.
  endpoint: ""
  region: auto
  bucket: ""
  prefix: [[.Name]]
  access_key_env: RAMEKIN_S3_ACCESS_KEY
  secret_key_env: RAMEKIN_S3_SECRET_KEY
  retention_days: 90
  retention_mode: GOVERNANCE

channels: [stable]
