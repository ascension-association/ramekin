FROM cgr.dev/chainguard/wolfi-base:latest

# Add packages from the Wolfi repository; keep the image small.
# RUN apk add --no-cache python-3.12

COPY --chmod=0755 app.sh /usr/local/bin/app

# ramekind runs this on the device. Install a SIGTERM handler (or use a
# command that has one) so updates can stop the app gracefully.
CMD ["/usr/local/bin/app"]
